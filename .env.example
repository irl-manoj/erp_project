# Copy to .env and set a private, random secret before deployment.
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
DEMO_PASSWORD=1234
# Demo-only sample invoice amount; not an official BIT Mesra fee.
DEMO_SEMESTER_FEE_INR=50000
# Set a private code to permit teacher self-registration; omit to keep teacher sign-up disabled.
# TEACHER_REGISTRATION_CODE=replace-with-a-private-invitation-code
# Optional overrides; defaults are ./data/academic.sqlite and ./uploads
# DB_PATH=/path/to/persistent-storage/academic.sqlite
# UPLOAD_DIR=/path/to/persistent-storage/uploads
